{
  "name": "prepvispro",
  "private": true,
  "version": "0.9.1",
  "license": "MIT",
  "type": "module",
  "description": "PrepVisPro — préparation image : découpage, plans au sol, plans feux.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:app": "VITE_TEST_HOOKS=1 tauri build --debug --no-bundle && xvfb-run -a node tauri-e2e/run.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "exceljs": "^4.4.0",
    "immer": "^11.1.21",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
