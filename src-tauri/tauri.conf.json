{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrepVisPro",
  "version": "0.10.1",
  "identifier": "fr.adrienrousseau.prepvispro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PrepVisPro",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' blob:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Video",
    "copyright": "© 2026 Adrien Rousseau",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "prepvis"
        ],
        "name": "Projet PrepVisPro",
        "role": "Editor",
        "contentTypes": [
          "fr.adrienrousseau.prepvispro.project"
        ],
        "exportedType": {
          "identifier": "fr.adrienrousseau.prepvispro.project",
          "conformsTo": [
            "com.apple.package",
            "public.composite-content"
          ]
        }
      }
    ]
  }
}
